---
import '../styles/global.css'
import { getAbsoluteLocaleUrl } from 'astro:i18n'
import { languages, langOf, type Lang } from '../i18n'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const lang = langOf(Astro.currentLocale)
const site = 'https://briansittmann.dev'
const canonical = new URL(Astro.url.pathname, site).href
// Every language version of this page, for `hreflang`; `x-default` points at the English one.
const alternates = (Object.keys(languages) as Lang[]).map((code) => ({ code, href: getAbsoluteLocaleUrl(code, '') }))
const ogLocale: Record<Lang, string> = { en: 'en_IE', es: 'es_ES' }
const ogAlt: Record<Lang, string> = {
  en: 'Brian Sittmann, Java and Spring Boot backend developer in Dublin',
  es: 'Brian Sittmann, desarrollador backend Java y Spring Boot en Dublín',
}

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Brian Sittmann',
  jobTitle: { en: 'Java Backend Developer', es: 'Desarrollador Backend Java' }[lang],
  url: canonical,
  email: 'mailto:brian.sittmann@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Dublin', addressCountry: 'IE' },
  sameAs: ['https://github.com/briansittmann', 'https://www.linkedin.com/in/brian-sittmann'],
  knowsAbout: ['Java', 'Spring Boot', 'REST APIs', 'TypeScript', 'React', 'PostgreSQL', 'MySQL'],
  knowsLanguage: ['es', 'en'],
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Made in design/favicon: "bs" in Geist SemiBold on the cobalt accent. -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl('en', '')} />
    <meta name="theme-color" content="#f4f4f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {alternates.filter((a) => a.code !== lang).map((a) => <meta property="og:locale:alternate" content={ogLocale[a.code]} />)}
    <!-- Made in design/og (`node design/og/shot.cjs`), one per language. -->
    <meta property="og:image" content={`${site}/og.${lang}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og.${lang}.png`} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(person)} />

    <!--
      Hold the first paint until the whole page is parsed (13 KB gzipped), so a language switch never
      reveals a half-built page and the restore script below runs before anything shows.
    -->
    <link rel="expect" href="#page-end" blocking="render" />

    <!--
      Theme before first paint: stored choice, else the system's. `.js` lets triggered entrances hide their start state.
      `.swap` marks a page reached from the language switch: it lands at rest instead of replaying its entrance.
    -->
    <script is:inline>
      (() => {
        document.documentElement.classList.add('js')
        try { if (sessionStorage.getItem('lang-swap')) document.documentElement.classList.add('swap') } catch {}
        let theme
        try { theme = localStorage.getItem('theme') } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        }
        document.documentElement.dataset.theme = theme
      })()
    </script>
  </head>
  <body class="min-h-dvh bg-bg text-ink">
    <slot />
    <!-- Language switch (LangSwitch.astro): reopen at the same place, with what is in view already at rest. -->
    <script is:inline id="page-end">
      (() => {
        let saved
        try {
          saved = JSON.parse(sessionStorage.getItem('lang-swap'))
          sessionStorage.removeItem('lang-swap')
        } catch {}
        if (!saved) return
        const section = document.querySelectorAll('main > section')[saved.i]
        if (section) {
          const top = section.getBoundingClientRect().top + scrollY
          scrollTo({ top: top + saved.r * section.offsetHeight, behavior: 'instant' })
        }
        document.querySelectorAll('.play').forEach((el) => {
          const r = el.getBoundingClientRect()
          if (r.top < innerHeight && r.bottom > 0) el.classList.add('in', 'now')
        })
        document.querySelector('.api')?.classList.add('open')
      })()
    </script>
  </body>
</html>
